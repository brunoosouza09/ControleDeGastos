# Copie este arquivo para .env.local (ignorado pelo git) e ajuste o endereço da API.
#
# Celular físico com Expo Go: use o IP do computador na rede Wi-Fi.
# Ao rodar "npm run api", o terminal mostra esse endereço.
# Emulador Android e navegador funcionam sem este arquivo.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333
